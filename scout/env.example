# Fit-to-Space secrets — LOCAL ONLY. Never commit, paste into prompts, or show in demos.
# Issued by CoStarSupportBot, HackPrinceton 2026 CoStar track.

# Hackathon data kit zip password
KIT_ZIP_PASSWORD=<your-value>

# Matterport Model API (GraphQL) — HTTP Basic auth: API key as username, API token as password
MATTERPORT_API_KEY=<your-value>
MATTERPORT_API_TOKEN=<your-value>

# Matterport Showcase SDK key — only works on allowed domain: localhost (http or https)
MATTERPORT_SDK_KEY=<your-value>

# Vexcel aerial imagery API
VEXCEL_API_KEY=<your-value>

# LLM provider for request parsing (fill in once chosen)
LLM_API_KEY=<your-value>

# OpenAI — used by the agent when no Anthropic key is set
OPENAI_API_KEY=<your-value>
# Anthropic — preferred model for the agent and the request parser
ANTHROPIC_API_KEY=<your-value>

# Optional: Google Maps Embed API browser key (restrict to Maps Embed API + localhost) for in-page Street View.
# Without it, Street View opens Google Maps in a new tab.
GOOGLE_MAPS_EMBED_KEY=<your-value>

# Optional: LangSmith tracing of every agent and sub-agent step
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=<your-value>
